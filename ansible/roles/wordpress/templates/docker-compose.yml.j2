x-config: &config
  restart: unless-stopped
  security_opt:
    - no-new-privileges:true
  cap_drop:
    - NET_RAW
    - MKNOD
    - AUDIT_WRITE
    - SYS_CHROOT
    - SETPCAP
    - FSETID
  stdin_open: true
  tty: true

name: "{{ wordpress_project_name }}"

services:
  mariadb:
    <<: *config
    image: mariadb:11.8
    container_name: {{ wordpress_db_container_name }}
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: '1'
      MYSQL_DATABASE: "{{ wordpress_db_name }}"
      MYSQL_USER: "{{ wordpress_db_user }}"
      MYSQL_PASSWORD: "{{ wordpress_db_password }}"
    volumes:
      - db_data:{{ wordpress_db_dir_path_dest | string | replace('"', '') | replace("'", "") }}:rw
      - "{{ wordpress_db_conf_path_host }}:{{ wordpress_db_conf_path_dest }}:ro"
      - "{{ wordpress_db_sql_template_path_host }}:{{ wordpress_db_sql_template_path_dest }}:ro"
    deploy:
      resources:
        limits:
          memory: "{{ wordpress_db_mem_limit }}"
        reservations:
          memory: "{{ wordpress_db_mem_res_limit }}"
    healthcheck:
      test: ["CMD-SHELL", "mariadb-admin ping -u {{ wordpress_db_user | default('wp_user') }} -p'{{ wordpress_db_password }}'"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudone-back

  wordpress:
    <<: *config
    build:
        context: ./wordpress
        dockerfile: Dockerfile
    container_name: {{ wordpress_wp_container_name }}
    environment:
      WORDPRESS_DB_HOST: mariadb
      WORDPRESS_DB_USER: "{{ wordpress_db_user }}"
      WORDPRESS_DB_PASSWORD: "{{ wordpress_db_password }}"
      WORDPRESS_DB_NAME: "{{ wordpress_db_name }}"
    volumes:
        - wordpress_data:/var/www/html:rw
        - "{{ wordpress_compose_src }}/wordpress/mu-plugins:/var/www/html/wp-content/mu-plugins:ro"
    deploy:
      resources:
        limits:
          memory: "{{ wordpress_wp_mem_limit }}"
        reservations:
          memory: "{{ wordpress_wp_mem_res_limit }}"
    depends_on:
      mariadb:
        condition: service_healthy
    healthcheck:
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudone-front
      - cloudone-back

  angie:
    <<: *config
    image: docker.angie.software/angie:1.11.5
    container_name: {{ wordpress_angie_container_name }}
    ports:
      - "{{ wordpress_expose_http | default('80') | int }}:80"
      - "{{ wordpress_expose_https | default('443') | int }}:443"
    volumes:
      - "{{ wordpress_angie_conf_path_host }}:{{ wordpress_angie_conf_path_dest }}:ro"
      - "{{ wordpress_cert_dir }}:/etc/angie/certs:ro"
    depends_on:
      wordpress:
        condition: service_healthy
      phpmyadmin:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "curl -q http://localhost/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    deploy:
      resources:
        limits:
          memory: 256m
        reservations:
          memory: 64m
    networks:
      - cloudone-front
      - monitoring

  phpmyadmin:
    <<: *config
    image: phpmyadmin:5.2-apache
    container_name: phpmyadmin
    environment:
      PMA_HOST: mariadb
    depends_on:
      mariadb:
        condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 128m
        reservations:
          memory: 64m
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost/ || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - cloudone-front
      - cloudone-back

  grafana:
    <<: *config
    image: grafana/grafana:13.0.1
    container_name: grafana
    volumes:
      - grafana_data:/var/lib/grafana
    ports:
      - "3000:3000"
    profiles:
      - monitoring
    depends_on:
      - prometheus
      # prometheus:
        # condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 512m
        reservations:
          memory: 256m
    networks:
      - monitoring

  prometheus:
    <<: *config
    image: prom/prometheus:v3.11.3
    container_name: prometheus
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
    ports:
      - "9090:9090"
    profiles:
      - monitoring
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:9090/-/healthy || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
    depends_on:
      - angie
      # angie:
        # condition: service_healthy
    deploy:
      resources:
        limits:
          memory: 512m
        reservations:
          memory: 256m
    networks:
      - monitoring


networks:
  cloudone-front:
    driver: bridge
  cloudone-back:
    driver: bridge
  monitoring:
    driver: bridge

volumes:
  db_data:
  wordpress_data:
  prometheus_data:
  grafana_data:
